# Public site URL, no trailing slash. Used for canonical, Open Graph, and sitemap
# after the domain is confirmed. Example: https://spiora.example
NEXT_PUBLIC_SITE_URL=

# Approved platform login URL. The header link is hidden until this is set.
NEXT_PUBLIC_PLATFORM_LOGIN_URL=

# Approved sales address. Shown in the footer only when set. Example: sales@spiora.example
NEXT_PUBLIC_SALES_EMAIL=

# HTTPS endpoint that receives demo requests. Both values are required.
# The route returns "unavailable" until they are set. Never commit real secrets.
DEMO_WEBHOOK_URL=
DEMO_WEBHOOK_SECRET=
